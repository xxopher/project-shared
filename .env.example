# CritiqAI environment variables
# Copy this file to .env and fill in values before running

# Gemini Flash API key (free tier)
GOOGLE_API_KEY=

# OAuth credentials for Drive/Sheets/Gmail MCP
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google MCP server URLs (SSE endpoints, each server runs on its own port)
DRIVE_MCP_URL=http://localhost:3000/mcp/sse
SHEETS_MCP_URL=http://localhost:3001/mcp/sse
GMAIL_MCP_URL=http://localhost:3002/mcp/sse

# Google Sheets ID for debate session history log
# (create a blank sheet, paste the ID from the URL)
DEBATE_LOG_SHEET_ID=
DEBATE_LOG_RANGE=Sheet1!A:G

# Default recipient for teacher report email drafts (HITL — never auto-sent)
TEACHER_EMAIL=

# Antigravity terminal sandboxing (set to 'docker' in dev)
GEMINI_SANDBOX=docker
